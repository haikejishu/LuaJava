#############################################################
#Windows

LUA_SRC=./lua-5.3.3/src
JDK= $(JAVA_HOME)
INCS= -I"$(JDK)/include" -I"$(JDK)/include/win32" -I"$(LUA_SRC)"
CFLAGS= -nologo -DWIN32 -DLUA_COMPAT_5_1 -DLUA_COMPAT_5_2  $(INCS)  -MD  


#########################################################
VERSION= 1.1

PKG= luajava-$(VERSION)
JAR_FILE= $(PKG).jar
SO_FILE= $(PKG).dll
DIST_DIR= $(PKG)

# $Id: config.win,v 1.2 2007-03-15 21:28:02 carregal Exp $

